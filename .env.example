# WebGuard Environment Configuration Template
# Copy this file to .env and fill in your actual production credentials.
# NEVER commit .env to source control.

# Server Settings
WEBGARD_HOST=127.0.0.1
WEBGARD_PORT=5000
FLASK_ENV=development

# Application Security Secrets
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
WEBGUARD_API_KEY=replace-with-your-admin-api-key

# Database Connection (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL=sqlite:///webguard.db

# Scan & Auditing Parameters
WEBGARD_SCAN_TIMEOUT=10
WEBGARD_CONCURRENCY=5
WEBGARD_USER_AGENT=WebGuard-Security-Posture-Auditor/1.0
GUEST_SCAN_LIMIT=3

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/callback

# Analytics Setup (Optional)
ANALYTICS_ID=
